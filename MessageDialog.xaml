<Window x:Class="PackageDownloader.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="440"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        KeyDown="Window_KeyDown">

  <Border Margin="20" CornerRadius="14" Background="{DynamicResource CardBrush}"
          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Шапка: иконка + заголовок + крестик (за неё можно тащить окно) -->
      <Grid Grid.Row="0" Margin="20,18,12,0" Background="Transparent" MouseLeftButtonDown="Header_Drag">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="IconBadge" Grid.Column="0" Width="38" Height="38" CornerRadius="10" VerticalAlignment="Top">
          <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource IconFont}" FontSize="18"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"
                   FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
        <Button x:Name="CloseBtn" Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                Click="Cancel_Click" ToolTip="Закрыть">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8BB;" FontSize="11"/>
        </Button>
      </Grid>

      <!-- Текст сообщения -->
      <TextBlock x:Name="MessageText" Grid.Row="1" Margin="72,8,24,2"
                 FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="19"/>

      <!-- Кнопки -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,20,20,20">
        <Button x:Name="CancelButton" Content="Отмена" Click="Cancel_Click" MinWidth="96" Margin="0,0,10,0"
                Visibility="Collapsed"/>
        <Button x:Name="OkButton" Content="OK" Click="Ok_Click" Style="{StaticResource AccentButton}"
                MinWidth="110" IsDefault="True"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
