<Window x:Class="PackageDownloader.BulkImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="620" Height="600"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        KeyDown="Window_KeyDown">

  <Border Margin="20" CornerRadius="14" Background="{DynamicResource CardBrush}"
          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Шапка -->
      <Grid Grid.Row="0" Margin="20,18,12,0" Background="Transparent" MouseLeftButtonDown="Header_Drag">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" VerticalAlignment="Top"
                Background="#268B4FF5">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A5;" FontSize="18" Foreground="#8B4FF5"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"
                   FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
        <Button Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                Click="Cancel_Click" ToolTip="Закрыть">
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8BB;" FontSize="11"/>
        </Button>
      </Grid>

      <TextBlock x:Name="HintText" Grid.Row="1" Margin="72,8,24,10" FontSize="13" TextWrapping="Wrap"
                 LineHeight="19" Foreground="{DynamicResource MutedBrush}"/>

      <!-- Поле ввода -->
      <Border Grid.Row="2" Margin="20,0,20,0" CornerRadius="9" BorderThickness="1"
              Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}">
        <Grid>
          <!-- Многострочное поле: свой набор свойств вместо FlatTextBox,
               шаблон которого центрирует содержимое по вертикали. -->
          <TextBox x:Name="ContentBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                   Margin="10,8" Background="Transparent" BorderThickness="0"
                   Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                   SelectionBrush="{StaticResource AccentBrush}"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   VerticalContentAlignment="Top" FontFamily="Cascadia Code, Consolas" FontSize="12"/>
          <TextBlock x:Name="PlaceholderText" Foreground="{DynamicResource PlaceholderBrush}"
                     IsHitTestVisible="False" Margin="13,9,0,0" VerticalAlignment="Top"
                     FontFamily="Cascadia Code, Consolas" FontSize="12">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=ContentBox}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>

      <!-- Секции зависимостей (только для package.json) -->
      <WrapPanel x:Name="SectionsPanel" Grid.Row="3" Margin="20,12,20,0">
        <CheckBox x:Name="DepsChk" Content="dependencies" IsChecked="True" Margin="0,0,16,4"/>
        <CheckBox x:Name="DevDepsChk" Content="devDependencies" Margin="0,0,16,4"/>
        <CheckBox x:Name="PeerDepsChk" Content="peerDependencies" Margin="0,0,16,4"/>
        <CheckBox x:Name="OptDepsChk" Content="optionalDependencies" Margin="0,0,0,4"/>
      </WrapPanel>

      <TextBlock x:Name="ErrorText" Grid.Row="4" Margin="20,10,20,0" FontSize="12" TextWrapping="Wrap"
                 Foreground="#FF6B6B" Visibility="Collapsed"/>

      <!-- Кнопки -->
      <Grid Grid.Row="5" Margin="20,16,20,20">
        <Button HorizontalAlignment="Left" MinWidth="130" Click="OpenFile_Click" Content="Открыть файл…"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Отмена" Click="Cancel_Click" MinWidth="96" Margin="0,0,10,0"/>
          <Button Content="Скачать" Click="Ok_Click" Style="{StaticResource AccentButton}"
                  MinWidth="130" IsDefault="True"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
