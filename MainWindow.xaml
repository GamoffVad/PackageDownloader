                                Click="McpBrowse_Click" Margin="4" MinWidth="84"/>
                      </Grid>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- LLM (Hugging Face) -->
              <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="16,14"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="6,0,0,12">
                <StackPanel>
                  <TextBlock Text="LLM (Hugging Face)" FontSize="11" FontWeight="SemiBold"
                             Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Адрес (endpoint)" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBox x:Name="HfUrlBox" Grid.Column="1"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Папка загрузки" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <!-- Поле с кнопкой внутри (как в поиске пакетов) -->
                    <Border Grid.Column="1" Height="40" Background="{DynamicResource InputBrush}"
                            CornerRadius="9" BorderThickness="1">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
