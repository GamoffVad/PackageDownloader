                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="13,0,0,0"/>
                        <Grid Grid.Column="1" Margin="10,0,0,0">
                          <TextBox x:Name="NpmDirBox" Style="{StaticResource FlatTextBox}"/>
                          <TextBlock Text="Путь к папке NPM…" Foreground="{DynamicResource PlaceholderBrush}"
