                <TextBlock Grid.Column="1" Text="Пакет · версии" VerticalAlignment="Center" Margin="10,0"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
              </Grid>
            </Border>

            <!-- Список результатов: версии пакета сгруппированы по имени -->
            <Border Grid.Row="5" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1"
                    CornerRadius="0,0,10,10" ClipToBounds="True">
              <Grid>
                <ListView x:Name="PyPiList" ItemContainerStyle="{StaticResource ListViewItemStyleFluent}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListView.GroupStyle>
                    <GroupStyle>
                      <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="GroupItem">
                                <StackPanel>
                                  <ToggleButton x:Name="GroupToggle" IsChecked="False" Focusable="False" Cursor="Hand">
                                    <ToggleButton.Template>
                                      <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="hb" Background="{DynamicResource HeaderBg}" Padding="12,7"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                          <Grid>
                                            <Grid.ColumnDefinitions>
                                              <ColumnDefinition Width="Auto"/>
                                              <ColumnDefinition Width="Auto"/>
                                              <ColumnDefinition Width="Auto"/>
                                              <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="chev" FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2" Background="{DynamicResource BadgeGrayBg}" CornerRadius="9" Padding="7,1"
                                                    Margin="9,0,0,0" VerticalAlignment="Center">
                                              <TextBlock FontSize="11" Foreground="{DynamicResource BadgeGrayFg}">
                                                <Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=" верс."/>
                                              </TextBlock>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding Items[0].Description, Converter={StaticResource SingleLine}}"
                                                       Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                                                       Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                                       ToolTipService.InitialShowDelay="220" ToolTipService.ShowDuration="60000"
                                                       ToolTipService.Placement="Bottom" local:ToolTipBehavior.CloseOnLeave="True">
                                              <ToolTipService.ToolTip>
                                                <ContentControl Content="{Binding Items[0]}" ContentTemplate="{StaticResource PkgTipTemplate}"/>
                                              </ToolTipService.ToolTip>
                                            </TextBlock>
                                          </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                          <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="chev" Property="Text" Value="&#xE76C;"/>
                                          </Trigger>
                                          <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="hb" Property="Background" Value="{DynamicResource RowHover}"/>
                                          </Trigger>
                                        </ControlTemplate.Triggers>
                                      </ControlTemplate>
                                    </ToggleButton.Template>
                                  </ToggleButton>
                                  <ItemsPresenter x:Name="ip"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                  <Trigger SourceName="GroupToggle" Property="IsChecked" Value="False">
                                    <Setter TargetName="ip" Property="Visibility" Value="Collapsed"/>
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </GroupStyle.ContainerStyle>
                    </GroupStyle>
                  </ListView.GroupStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid Height="38">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="44"/>
                          <ColumnDefinition Width="36"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="PyPiItemCheck_Click"/>
                        <TextBlock Grid.Column="1" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Version}" FontSize="12.5"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="2,0"/>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>

                <!-- Пусто -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=PyPiList}" Value="False">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <TextBlock Text="&#xE943;" FontFamily="{StaticResource IconFont}" FontSize="34"
                             Foreground="#3A3A5C" HorizontalAlignment="Center"/>
                  <TextBlock Text="Введите запрос и нажмите «Найти»" Foreground="{DynamicResource MutedBrush}"
                             FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Кнопки скачивания -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="PyPiFileBtn" Click="PyPiRequirements_Click" MinWidth="170" Margin="0,0,8,0"
                      ToolTip="Вставить requirements.txt / pyproject.toml / Pipfile и скачать всё с зависимостями">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A5;" FontSize="13"
                             Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock Text="requirements.txt" VerticalAlignment="Center" Margin="6,0,0,0"
                             Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
              </Button>
              <Button x:Name="PyPiDownloadBtn" Style="{StaticResource AccentButton}"
                      Click="PyPiDownload_Click" MinWidth="130">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="13" Foreground="White"/>
                  <TextBlock Text="Скачать" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="White"/>
                </StackPanel>
              </Button>
              <Button x:Name="PyPiCancelBtn" Content="✕ Отмена" Click="PyPiCancel_Click"
                      MinWidth="90" Margin="8,0,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Прогресс -->
            <ProgressBar x:Name="PyPiProgress" Grid.Row="9" IsIndeterminate="True" Visibility="Collapsed"/>

            <!-- Лог -->
            <Border Grid.Row="11" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
              <ScrollViewer x:Name="PyPiLogScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="PyPiLog" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                           FontFamily="Cascadia Code, Consolas" FontSize="12" Margin="12,8"/>
              </ScrollViewer>
            </Border>
          </Grid>
        </Border>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ══ Администрирование (прижата вправо) ════════════════════════ -->
      <TabItem x:Name="AdminTab" DockPanel.Dock="Right">
        <TabItem.Header>
          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="15" VerticalAlignment="Center"/>
        </TabItem.Header>

        <TabControl Style="{StaticResource VerticalTabControl}">

          <!-- ── Под-вкладка: Пути и реестры ── -->
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="Пути и реестры" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </StackPanel>
            </TabItem.Header>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Border Padding="24,20,24,20">
                <StackPanel>

                  <TextBlock Text="Адреса источников пакетов и папки для скачанных файлов."
                             FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14"/>

              <!-- Карточки источников в две колонки (компактно) -->
              <UniformGrid Columns="2">

              <!-- NuGet -->
              <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="16,14"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,6,12">
                <StackPanel>
                  <TextBlock Text="NuGet" FontSize="11" FontWeight="SemiBold"
                             Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="URL реестра" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBox x:Name="NugetUrlBox" Grid.Column="1"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Папка загрузки" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <!-- Поле с кнопкой внутри (как в поиске пакетов) -->
                    <Border Grid.Column="1" Height="40" Background="{DynamicResource InputBrush}"
                            CornerRadius="9" BorderThickness="1">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                          <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="BorderBrush" Value="#43436A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                              <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="13,0,0,0"/>
                        <Grid Grid.Column="1" Margin="10,0,0,0">
                          <TextBox x:Name="NugetDirBox" Style="{StaticResource FlatTextBox}"/>
                          <TextBlock Text="Путь к папке NuGet…" Foreground="{DynamicResource PlaceholderBrush}"
                                     Margin="2,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Text, ElementName=NugetDirBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Grid>
                        <Button Grid.Column="2" Style="{StaticResource SearchButton}" Content="Обзор"
                                Click="NugetBrowse_Click" Margin="4" MinWidth="84"/>
                      </Grid>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- NPM -->
              <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="16,14"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="6,0,0,12">
