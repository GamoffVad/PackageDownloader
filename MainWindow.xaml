                          <TextBox x:Name="HfDirBox" Style="{StaticResource FlatTextBox}"/>
                          <TextBlock Text="Путь к папке моделей…" Foreground="{DynamicResource PlaceholderBrush}"
                                     Margin="2,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Text, ElementName=HfDirBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Grid>
                        <Button Grid.Column="2" Style="{StaticResource SearchButton}" Content="Обзор"
                                Click="HfBrowse_Click" Margin="4" MinWidth="84"/>
                      </Grid>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Python (PyPI) -->
              <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="16,14"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,6,12">
                <StackPanel>
                  <TextBlock Text="Python (PyPI)" FontSize="11" FontWeight="SemiBold"
                             Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Индекс (JSON API)" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBox x:Name="PyPiUrlBox" Grid.Column="1"/>
                  </Grid>
                  <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Версия Python" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
