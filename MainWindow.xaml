                    <TextBlock Grid.Column="0" Text="URL реестра" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <TextBox x:Name="McpUrlBox" Grid.Column="1"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="*"/>
