                    <TextBlock Grid.Column="0" Text="Папка загрузки" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <!-- Поле с кнопкой внутри (как в поиске пакетов) -->
                    <Border Grid.Column="1" Height="40" Background="{DynamicResource InputBrush}"
                            CornerRadius="9" BorderThickness="1">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
