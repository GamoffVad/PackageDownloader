                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Папка загрузки" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <!-- Поле с кнопкой внутри (как в поиске пакетов) -->
                    <Border Grid.Column="1" Height="40" Background="{DynamicResource InputBrush}"
                            CornerRadius="9" BorderThickness="1">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                          <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="BorderBrush" Value="#43436A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                              <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="13,0,0,0"/>
                        <Grid Grid.Column="1" Margin="10,0,0,0">
                          <TextBox x:Name="PyPiDirBox" Style="{StaticResource FlatTextBox}"/>
                          <TextBlock Text="Путь к папке Python…" Foreground="{DynamicResource PlaceholderBrush}"
                                     Margin="2,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Text, ElementName=PyPiDirBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Grid>
                        <Button Grid.Column="2" Style="{StaticResource SearchButton}" Content="Обзор"
                                Click="PyPiBrowse_Click" Margin="4" MinWidth="84"/>
                      </Grid>
                    </Border>
                  </Grid>
                </StackPanel>
              </Border>

              </UniformGrid>

                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Сохранить пути" Click="AdminSave_Click"
                            Style="{StaticResource AccentButton}" MinWidth="150"/>
                  </StackPanel>

                </StackPanel>
              </Border>
            </ScrollViewer>
          </TabItem>

          <!-- ── Под-вкладка: NPM-реестр ── -->
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE774;" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="NPM-реестр" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </StackPanel>
            </TabItem.Header>

            <Border Padding="24,20,24,20">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,6,0"
                             Text="Запускает HTTP-сервер с npm registry API из папки NPM. Разработчики в корпоративной сети могут ставить пакеты командой:  npm install &lt;пакет&gt; --registry &lt;URL&gt;"/>
                  <Button Grid.Column="1" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                          Click="NpmHelp_Click" ToolTip="Инструкция по NPM-реестру"
                          >
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE897;" FontSize="14"/>
                  </Button>
                </Grid>

              <Border Grid.Row="1" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="16,14"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="16"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource InputBrush}" CornerRadius="10"
                            Padding="10,5" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ServerStatusDot" Width="8" Height="8"
                                 Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ServerStatusText" Text="Остановлен" Margin="8,0,0,0"
                                   FontSize="12" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>

                    <!-- Поле порта с кнопкой внутри (как в поиске пакетов) -->
                    <Border Grid.Column="2" Height="40" Background="{DynamicResource InputBrush}"
                            CornerRadius="9" BorderThickness="1">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                          <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="BorderBrush" Value="#43436A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                              <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" Text="&#xE774;" FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="13,0,0,0"/>
                        <TextBlock x:Name="NpmPortLabel" Grid.Column="1" Text="Порт:" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0"/>
                        <TextBox x:Name="NpmPortBox" Grid.Column="2" Style="{StaticResource FlatTextBox}"
                                 Text="4873" Margin="8,0,0,0"/>
                        <Button x:Name="StartServerBtn" Grid.Column="3" Click="StartServer_Click"
                                Style="{StaticResource SearchButton}" MinWidth="120" Margin="4">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Запустить" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                        <Button x:Name="StopServerBtn" Grid.Column="3" Click="StopServer_Click"
                                Style="{StaticResource SearchButton}" MinWidth="120" Margin="4" Visibility="Collapsed">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71A;" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="Остановить" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Border>
                  </Grid>

                  <Border x:Name="ServerUrlPanel" Background="{DynamicResource InputBrush}" CornerRadius="8"
                          Padding="12,10" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel>
                      <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="72"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="В сети:" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock x:Name="ServerNetUrlText" Grid.Column="1" FontFamily="Cascadia Code, Consolas"
                                   Foreground="{StaticResource AccentBrush}" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="CopyNetUrlBtn" Grid.Column="2" Style="{StaticResource IconButton}"
                                Click="CopyNetUrl_Click" ToolTip="Скопировать URL">
                          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" FontSize="14"/>
                        </Button>
                      </Grid>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="72"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Локально:" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock x:Name="ServerLocalUrlText" Grid.Column="1" FontFamily="Cascadia Code, Consolas"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </Grid>

                      <!-- Команды для клиента в корпоративной сети -->
                      <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,8"/>
                      <TextBlock Text="На клиенте в корпоративной сети — один раз настроить реестр:"
                                 Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource ConsoleBg}" CornerRadius="6" Padding="10,6">
                          <TextBlock x:Name="ServerCmdText" FontFamily="Cascadia Code, Consolas" FontSize="12"
                                     Foreground="{DynamicResource ConsoleFg}" TextTrimming="CharacterEllipsis"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Border>
                        <Button x:Name="CopyCmdBtn" Grid.Column="1" Style="{StaticResource IconButton}"
                                Click="CopyCmd_Click" ToolTip="Скопировать команду" Margin="6,0,0,0">
                          <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" FontSize="14"/>
                        </Button>
                      </Grid>
                      <TextBlock Margin="2,7,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}">
                        <Run Text="а затем устанавливать пакеты:"/>
                        <Run Text="  npm i &lt;название-пакета&gt;" FontFamily="Cascadia Code, Consolas"
                             Foreground="{DynamicResource TextBrush}"/>
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

                  <!-- ── Консоль сервера (логи в реальном времени) ── -->
                  <Border Grid.Row="2" Background="{DynamicResource ConsoleBg}" CornerRadius="10" BorderThickness="1"
                          BorderBrush="{DynamicResource BorderBrush}" Margin="0,14,0,0">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>

                      <Grid Grid.Row="0" Height="38">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE756;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <TextBlock Grid.Column="1" Text="Консоль сервера" VerticalAlignment="Center" Margin="8,0,0,0"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                        <Button Grid.Column="2" Content="Очистить" Click="ClearServerLog_Click"
                                Margin="0,0,12,0" Padding="14,6" FontSize="11" VerticalAlignment="Center"/>
                      </Grid>

                      <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                          <ScrollViewer x:Name="NpmServerLogScroll" VerticalScrollBarVisibility="Auto" Padding="14,8">
                            <TextBlock x:Name="NpmServerLog" TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas"
                                       FontSize="12" Foreground="{DynamicResource ConsoleFg}" LineHeight="18"/>
                          </ScrollViewer>
                          <TextBlock Text="Журнал появится после запуска реестра…"
                                     Foreground="{DynamicResource PlaceholderBrush}" FontSize="12"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Text, ElementName=NpmServerLog}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Grid>
                      </Border>
                    </Grid>
                  </Border>

              </Grid>
            </Border>
          </TabItem>

          <!-- ── Под-вкладка: NuGet-реестр ── -->
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C6;" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="NuGet-реестр" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </StackPanel>
            </TabItem.Header>

            <Border Padding="24,20,24,20">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,6,0"
                             Text="Запускает HTTP-сервер с NuGet V3 API из папки NuGet. Разработчики прописывают URL один раз в nuget.config — после чего dotnet restore / dotnet build находят пакеты автоматически, без VPN и интернета."/>
                  <Button Grid.Column="1" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                          Click="NugetHelp_Click" ToolTip="Инструкция по NuGet-реестру"
                          >
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE897;" FontSize="14"/>
                  </Button>
                </Grid>

                <!-- Карточка управления -->
                <Border Grid.Row="1" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="16,14"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>

                      <!-- Индикатор статуса -->
                      <Border Grid.Column="0" Background="{DynamicResource InputBrush}" CornerRadius="10"
                              Padding="10,5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse x:Name="NugetServerStatusDot" Width="8" Height="8"
                                   Fill="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                          <TextBlock x:Name="NugetServerStatusText" Text="Остановлен" Margin="8,0,0,0"
                                     FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Border>

                      <!-- Порт + кнопки -->
                      <Border Grid.Column="2" Height="40" Background="{DynamicResource InputBrush}"
                              CornerRadius="9" BorderThickness="1">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Style.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#43436A"/>
                              </Trigger>
                              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" Text="&#xE8C6;" FontSize="13"
                                     Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="13,0,0,0"/>
                          <TextBlock x:Name="NugetPortLabel" Grid.Column="1" Text="Порт:" VerticalAlignment="Center"
                                     Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0"/>
                          <TextBox x:Name="NugetPortBox" Grid.Column="2" Style="{StaticResource FlatTextBox}"
                                   Text="5000" Margin="8,0,0,0"/>
                          <Button x:Name="StartNugetServerBtn" Grid.Column="3" Click="StartNugetServer_Click"
                                  Style="{StaticResource SearchButton}" MinWidth="120" Margin="4">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                              <TextBlock Text="Запустить" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                          <Button x:Name="StopNugetServerBtn" Grid.Column="3" Click="StopNugetServer_Click"
                                  Style="{StaticResource SearchButton}" MinWidth="120" Margin="4" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71A;" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                              <TextBlock Text="Остановить" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                    </Grid>

                    <!-- URL + инструкция nuget.config -->
                    <Border x:Name="NugetServerUrlPanel" Background="{DynamicResource InputBrush}" CornerRadius="8"
                            Padding="12,10" Margin="0,12,0,0" Visibility="Collapsed">
                      <StackPanel>
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="В сети:" Foreground="{DynamicResource MutedBrush}"
                                     VerticalAlignment="Center" FontSize="12"/>
                          <TextBlock x:Name="NugetServerNetUrlText" Grid.Column="1" FontFamily="Cascadia Code, Consolas"
                                     Foreground="{StaticResource AccentBrush}" FontSize="12"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                  Click="CopyNugetNetUrl_Click" ToolTip="Скопировать URL">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" FontSize="14"/>
                          </Button>
                        </Grid>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Text="Локально:" Foreground="{DynamicResource MutedBrush}"
                                     VerticalAlignment="Center" FontSize="12"/>
                          <TextBlock x:Name="NugetServerLocalUrlText" Grid.Column="1" FontFamily="Cascadia Code, Consolas"
                                     Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,8"/>
                        <TextBlock Text="Добавьте в nuget.config проекта (или глобальный %AppData%\NuGet\NuGet.Config):"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Background="{DynamicResource ConsoleBg}" CornerRadius="6" Padding="10,6">
                            <TextBlock x:Name="NugetServerCmdText" FontFamily="Cascadia Code, Consolas" FontSize="11.5"
                                       Foreground="{DynamicResource ConsoleFg}" TextWrapping="Wrap"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                          </Border>
                          <Button x:Name="CopyNugetCmdBtn" Grid.Column="1" Style="{StaticResource IconButton}"
                                  Click="CopyNugetCmd_Click" ToolTip="Скопировать конфиг" Margin="6,0,0,0">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" FontSize="14"/>
                          </Button>
                        </Grid>
                        <TextBlock Margin="2,7,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   Text="Затем: dotnet restore   (или нажмите «Восстановить пакеты» в Visual Studio)"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <!-- Консоль -->
                <Border Grid.Row="2" Background="{DynamicResource ConsoleBg}" CornerRadius="10" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}" Margin="0,14,0,0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Height="38">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="&#xE756;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                 Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                      <TextBlock Grid.Column="1" Text="Консоль реестра" VerticalAlignment="Center" Margin="8,0,0,0"
                                 FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                      <Button Grid.Column="2" Content="Очистить" Click="ClearNugetServerLog_Click"
                              Margin="0,0,12,0" Padding="14,6" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                      <Grid>
                        <ScrollViewer x:Name="NugetServerLogScroll" VerticalScrollBarVisibility="Auto" Padding="14,8">
                          <TextBlock x:Name="NugetServerLog" TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas"
                                     FontSize="12" Foreground="{DynamicResource ConsoleFg}" LineHeight="18"/>
                        </ScrollViewer>
                        <TextBlock Text="Журнал появится после запуска реестра…"
                                   Foreground="{DynamicResource PlaceholderBrush}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=NugetServerLog}" Value="">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                    </Border>
                  </Grid>
                </Border>

              </Grid>
            </Border>
          </TabItem>

        </TabControl>
      </TabItem>
      <!-- ══ Скачанные ═════════════════════════════════════════════════ -->
      <TabItem x:Name="LocalTab" DockPanel.Dock="Right">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock Text="Скачанные" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>
        </TabItem.Header>

        <Border Padding="24,20,24,16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Тулбар -->
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <!-- Переключатель типа -->
              <Border Grid.Column="0" Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="3"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="LocalFilterAll" Style="{StaticResource SegmentButton}" Content="Все" Tag="All" IsChecked="True"
                               GroupName="locfilter" Checked="LocalFilter_Changed"/>
                  <RadioButton x:Name="LocalFilterNuGet" Style="{StaticResource SegmentButton}" Content="NuGet" Tag="NuGet"
                               GroupName="locfilter" Checked="LocalFilter_Changed"/>
                  <RadioButton x:Name="LocalFilterNpm" Style="{StaticResource SegmentButton}" Content="NPM" Tag="NPM"
                               GroupName="locfilter" Checked="LocalFilter_Changed"/>
                  <RadioButton x:Name="LocalFilterMcp" Style="{StaticResource SegmentButton}" Content="MCP" Tag="MCP"
                               GroupName="locfilter" Checked="LocalFilter_Changed"/>
                  <RadioButton x:Name="LocalFilterLlm" Style="{StaticResource SegmentButton}" Content="LLM" Tag="LLM"
                               GroupName="locfilter" Checked="LocalFilter_Changed"/>
                  <RadioButton x:Name="LocalFilterPyPi" Style="{StaticResource SegmentButton}" Content="Python" Tag="PyPI"
                               GroupName="locfilter" Checked="LocalFilter_Changed"/>
                </StackPanel>
              </Border>

              <!-- Обновить (только значок) -->
              <Button Grid.Column="2" Click="LocalRefresh_Click" ToolTip="Обновить">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" FontSize="13" VerticalAlignment="Center"/>
              </Button>

              <TextBlock x:Name="LocalCountLabel" Grid.Column="4" VerticalAlignment="Center"
                         FontSize="12" Foreground="{DynamicResource MutedBrush}"/>

              <!-- Кнопки папок (по правому краю) -->
              <Button Grid.Column="6" Click="LocalOpenNuget_Click" ToolTip="Открыть папку NuGet">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" FontSize="13" VerticalAlignment="Center"/>
                  <TextBlock Text="NuGet" VerticalAlignment="Center" Margin="7,0,0,0"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="7" Click="LocalOpenNpm_Click" Margin="8,0,0,0" ToolTip="Открыть папку NPM">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" FontSize="13" VerticalAlignment="Center"/>
                  <TextBlock Text="NPM" VerticalAlignment="Center" Margin="7,0,0,0"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="8" Click="LocalOpenMcp_Click" Margin="8,0,0,0" ToolTip="Открыть папку MCP">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" FontSize="13" VerticalAlignment="Center"/>
                  <TextBlock Text="MCP" VerticalAlignment="Center" Margin="7,0,0,0"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="9" Click="LocalOpenLlm_Click" Margin="8,0,0,0" ToolTip="Открыть папку LLM">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" FontSize="13" VerticalAlignment="Center"/>
                  <TextBlock Text="LLM" VerticalAlignment="Center" Margin="7,0,0,0"/>
                </StackPanel>
              </Button>
              <Button Grid.Column="10" Click="LocalOpenPyPi_Click" Margin="8,0,0,0" ToolTip="Открыть папку Python">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" FontSize="13" VerticalAlignment="Center"/>
                  <TextBlock Text="Python" VerticalAlignment="Center" Margin="7,0,0,0"/>
                </StackPanel>
              </Button>
            </Grid>

            <!-- Заголовки колонок -->
            <Border Grid.Row="2" Background="{DynamicResource HeaderBg}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0"
                    CornerRadius="10,10,0,0">
              <Grid Height="36">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="220"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="96"/>
                  <ColumnDefinition Width="84"/>
                  <ColumnDefinition Width="130"/>
                  <ColumnDefinition Width="96"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Тип"      VerticalAlignment="Center" Margin="14,0" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="Пакет"    VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="Описание" VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="Версия"   VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Text="Размер"   VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="5" Text="Дата"     VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="6" Text="Действия" VerticalAlignment="Center" Margin="10,0" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
              </Grid>
            </Border>

            <!-- Список -->
            <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1"
                    CornerRadius="0,0,10,10">
              <Grid>
                <ListView x:Name="LocalList" ItemContainerStyle="{StaticResource ListViewItemStyleFluent}">
                  <ListView.GroupStyle>
                    <GroupStyle>
                      <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="GroupItem">
                                <StackPanel>
                                  <ToggleButton x:Name="GroupToggle" IsChecked="False" Focusable="False" Cursor="Hand">
                                    <ToggleButton.Template>
                                      <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="hb" Background="{DynamicResource HeaderBg}" Padding="12,7"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                          <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="chev" FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Background="{DynamicResource BadgeGrayBg}" CornerRadius="9" Padding="7,1"
                                                    Margin="9,0,0,0" VerticalAlignment="Center">
                                              <TextBlock FontSize="11" Foreground="{DynamicResource BadgeGrayFg}">
                                                <Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=" верс."/>
                                              </TextBlock>
                                            </Border>
                                          </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                          <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="chev" Property="Text" Value="&#xE76C;"/>
                                          </Trigger>
                                          <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="hb" Property="Background" Value="{DynamicResource RowHover}"/>
                                          </Trigger>
                                        </ControlTemplate.Triggers>
                                      </ControlTemplate>
                                    </ToggleButton.Template>
                                  </ToggleButton>
                                  <ItemsPresenter x:Name="ip"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                  <Trigger SourceName="GroupToggle" Property="IsChecked" Value="False">
                                    <Setter TargetName="ip" Property="Visibility" Value="Collapsed"/>
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </GroupStyle.ContainerStyle>
                    </GroupStyle>
                  </ListView.GroupStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid MinHeight="42">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="70"/>
                          <ColumnDefinition Width="220"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="96"/>
                          <ColumnDefinition Width="84"/>
                          <ColumnDefinition Width="130"/>
                          <ColumnDefinition Width="96"/>
                        </Grid.ColumnDefinitions>

                        <!-- Бейдж типа -->
                        <Border Grid.Column="0" CornerRadius="5" Padding="8,2"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="{DynamicResource BadgeBlueBg}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="NPM">
                                  <Setter Property="Background" Value="{DynamicResource BadgeRedBg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="MCP">
                                  <Setter Property="Background" Value="{DynamicResource BadgeGreenBg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="LLM">
                                  <Setter Property="Background" Value="{DynamicResource BadgeYellowBg}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="PyPI">
                                  <Setter Property="Background" Value="{DynamicResource BadgePurpleBg}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="SemiBold">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{DynamicResource BadgeBlueFg}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Kind}" Value="NPM">
                                    <Setter Property="Foreground" Value="{DynamicResource BadgeRedFg}"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Kind}" Value="MCP">
                                    <Setter Property="Foreground" Value="{DynamicResource BadgeGreenFg}"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Kind}" Value="LLM">
                                    <Setter Property="Foreground" Value="{DynamicResource BadgeYellowFg}"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Kind}" Value="PyPI">
                                    <Setter Property="Foreground" Value="{DynamicResource BadgePurpleFg}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </Border>

                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Summary, Converter={StaticResource SingleLine}}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Summary}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Summary}" Value="">
                                  <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="3" Text="{Binding Version}" Foreground="{DynamicResource SubtleBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="10,0"/>
                        <TextBlock Grid.Column="4" Text="{Binding SizeDisplay}" Foreground="{DynamicResource SubtleBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="10,0"/>
                        <TextBlock Grid.Column="5" Text="{Binding ModifiedDisplay}" Foreground="{DynamicResource SubtleBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="10,0"/>
                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <!-- README (только для NPM-пакетов) -->
                          <Button Click="LocalReadme_Click" ToolTip="Читать README">
                            <Button.Style>
                              <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Kind}" Value="NPM">
                                    <Setter Property="Visibility" Value="Visible"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Kind}" Value="MCP">
                                    <Setter Property="Visibility" Value="Visible"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding Kind}" Value="LLM">
                                    <Setter Property="Visibility" Value="Visible"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F6;" FontSize="15"/>
                          </Button>
                          <Button Style="{StaticResource IconButton}" Click="LocalReveal_Click" ToolTip="Показать в проводнике">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="15"/>
                          </Button>
                          <Button Style="{StaticResource IconButton}" Click="LocalDelete_Click" ToolTip="Удалить файл">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" FontSize="15"/>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>

                <!-- Пусто -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=LocalList}" Value="False">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="34"
                             Foreground="#3A3A5C" HorizontalAlignment="Center"/>
                  <TextBlock Text="Пока нет скачанных пакетов" Foreground="{DynamicResource MutedBrush}"
                             FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                  <TextBlock Text="Задайте папки в «Настройках» и нажмите «Обновить»"
                             Foreground="{DynamicResource PlaceholderBrush}" FontSize="11"
                             HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </TabItem>


    </TabControl>
  </Grid>
</Window>
