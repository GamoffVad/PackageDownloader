<Window x:Class="PackageDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PackageDownloader"
        Title="Package Downloader" Width="1060" Height="900"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" Icon="app.ico"
        Background="{DynamicResource AppBgBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                  CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ═══ Свой заголовок окна ══════════════════════════════════════════ -->
    <Border Grid.Row="0" Height="40" Background="{DynamicResource HeaderBg}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Логотип + название (анимированный значок) -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Border x:Name="LogoBox" Width="24" Height="24" CornerRadius="7">
            <Border.Background>
              <SolidColorBrush Color="#7C3AED"/>
            </Border.Background>
            <!-- Стильная стрелка загрузки (линейная графика): стержень + шеврон + поднос -->
            <Viewbox Margin="3">
              <Canvas Width="34" Height="34">
                <Path Stroke="White" StrokeThickness="2.3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M 17,8 L 17,17.6  M 11.9,12.8 L 17,18.3 L 22.1,12.8">
                  <Path.RenderTransform>
                    <TranslateTransform x:Name="ArrowT" Y="0"/>
                  </Path.RenderTransform>
                </Path>
                <Path Stroke="White" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 11.4,24 L 22.6,24"/>
              </Canvas>
            </Viewbox>
          </Border>
          <TextBlock Text="Package Downloader" FontWeight="Bold" FontSize="13"
                     VerticalAlignment="Center" Margin="9,0,0,0"/>
        </StackPanel>

        <!-- Кнопки управления окном -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch"
                    WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="ThemeToggleBtn" Style="{StaticResource CaptionButton}" Click="ThemeToggle_Click"
                  ToolTip="Светлая / тёмная тема">
            <TextBlock x:Name="ThemeGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE706;" FontSize="14"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Свернуть">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE921;" FontSize="10"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button x:Name="MaxRestoreBtn" Style="{StaticResource CaptionButton}" Click="MaxRestore_Click" ToolTip="Развернуть">
            <TextBlock x:Name="MaxRestoreGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE922;" FontSize="10"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button Style="{StaticResource CloseCaptionButton}" Click="CloseWin_Click" ToolTip="Закрыть">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8BB;" FontSize="10"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ Вкладки ═══════════════════════════════════════════════════════ -->
    <TabControl x:Name="MainTabs" Grid.Row="1" Background="{DynamicResource AppBgBrush}"
                SelectionChanged="MainTabs_SelectionChanged">

      <!-- ══ Скачать ═══════════════════════════════════════════════════ -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock Text="Скачать" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>
        </TabItem.Header>

        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Переключатель источника (как в «Скачанные») -->
          <Border Grid.Row="0" Margin="24,16,24,0" HorizontalAlignment="Left"
                  Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="3"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="DlSecNuget" Style="{StaticResource SegmentButton}" Content="NuGet" Tag="NuGet" IsChecked="True" GroupName="dlsection" Checked="DownloadSection_Changed"/>
              <RadioButton x:Name="DlSecNpm" Style="{StaticResource SegmentButton}" Content="NPM" Tag="NPM" GroupName="dlsection" Checked="DownloadSection_Changed"/>
              <RadioButton x:Name="DlSecMcp" Style="{StaticResource SegmentButton}" Content="MCP" Tag="MCP" GroupName="dlsection" Checked="DownloadSection_Changed"/>
              <RadioButton x:Name="DlSecLlm" Style="{StaticResource SegmentButton}" Content="LLM" Tag="LLM" GroupName="dlsection" Checked="DownloadSection_Changed"/>
              <RadioButton x:Name="DlSecPython" Style="{StaticResource SegmentButton}" Content="Python" Tag="Python" GroupName="dlsection" Checked="DownloadSection_Changed"/>
            </StackPanel>
          </Border>

          <!-- Панели источников (видна только выбранная) -->
          <Grid Grid.Row="1">
      <!-- ══ NuGet ═════════════════════════════════════════════════════ -->
          <Border x:Name="SecNuget" Padding="24,10,24,16">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="4"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="8"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <!-- Поиск (поле и кнопка объединены) -->
            <Border Grid.Row="0" Height="40" Background="{DynamicResource InputBrush}"
                    CornerRadius="9" BorderThickness="1">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="BorderBrush" Value="#43436A"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="13"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="13,0,0,0"/>
                <Grid Grid.Column="1" Margin="10,0,0,0">
                  <TextBox x:Name="NugetSearchBox" Style="{StaticResource FlatTextBox}" KeyDown="NugetSearchBox_KeyDown"/>
                  <TextBlock Text="Поиск NuGet пакетов…" Foreground="{DynamicResource PlaceholderBrush}"
                             Margin="2,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=NugetSearchBox}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <Button x:Name="NugetSearchBtn" Grid.Column="2" Style="{StaticResource SearchButton}"
                        Click="NugetSearch_Click" Content="Найти" Margin="4" MinWidth="84"/>
              </Grid>
            </Border>

            <!-- Тулбар -->
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="NugetCountLabel" Grid.Column="0" VerticalAlignment="Center"
                         FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
              <TextBlock x:Name="NugetSelLabel" Grid.Column="1" VerticalAlignment="Center"
                         FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                         Visibility="Collapsed"/>
            </Grid>

            <!-- Заголовки колонок -->
            <Border Grid.Row="4" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0"
                    CornerRadius="10,10,0,0">
              <Grid Height="44" Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="NugetSelectAllChk" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Margin="0" ToolTip="Выбрать все версии" Checked="NugetSelectAll_Changed" Unchecked="NugetSelectAll_Changed"/>
                <TextBlock Grid.Column="1" Text="Пакет · версии" VerticalAlignment="Center" Margin="10,0"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
              </Grid>
            </Border>

            <!-- Список результатов: пакеты сгруппированы по имени, внутри — версии -->
            <Border Grid.Row="5" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1"
                    CornerRadius="0,0,10,10" ClipToBounds="True">
              <Grid>
                <ListView x:Name="NugetList" ItemContainerStyle="{StaticResource ListViewItemStyleFluent}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListView.GroupStyle>
                    <GroupStyle>
                      <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="GroupItem">
                                <StackPanel>
                                  <ToggleButton x:Name="GroupToggle" IsChecked="False" Focusable="False" Cursor="Hand">
                                    <ToggleButton.Template>
                                      <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="hb" Background="{DynamicResource HeaderBg}" Padding="12,7"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                          <Grid>
                                            <Grid.ColumnDefinitions>
                                              <ColumnDefinition Width="Auto"/>
                                              <ColumnDefinition Width="Auto"/>
                                              <ColumnDefinition Width="Auto"/>
                                              <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="chev" FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2" Background="{DynamicResource BadgeGrayBg}" CornerRadius="9" Padding="7,1"
                                                    Margin="9,0,0,0" VerticalAlignment="Center">
                                              <TextBlock FontSize="11" Foreground="{DynamicResource BadgeGrayFg}">
                                                <Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=" верс."/>
                                              </TextBlock>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding Items[0].Description, Converter={StaticResource SingleLine}}"
                                                       Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                                                       Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                                       ToolTipService.InitialShowDelay="220" ToolTipService.ShowDuration="60000"
                                                       ToolTipService.Placement="Bottom" local:ToolTipBehavior.CloseOnLeave="True">
                                              <ToolTipService.ToolTip>
                                                <ContentControl Content="{Binding Items[0]}" ContentTemplate="{StaticResource PkgTipTemplate}"/>
                                              </ToolTipService.ToolTip>
                                            </TextBlock>
                                          </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                          <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="chev" Property="Text" Value="&#xE76C;"/>
                                          </Trigger>
                                          <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="hb" Property="Background" Value="{DynamicResource RowHover}"/>
                                          </Trigger>
                                        </ControlTemplate.Triggers>
                                      </ControlTemplate>
                                    </ToggleButton.Template>
                                  </ToggleButton>
                                  <ItemsPresenter x:Name="ip"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                  <Trigger SourceName="GroupToggle" Property="IsChecked" Value="False">
                                    <Setter TargetName="ip" Property="Visibility" Value="Collapsed"/>
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </GroupStyle.ContainerStyle>
                    </GroupStyle>
                  </ListView.GroupStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid Height="38">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="44"/>
                          <ColumnDefinition Width="36"/>
                          <ColumnDefinition Width="120"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="NugetItemCheck_Click"/>
                        <TextBlock Grid.Column="1" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Version}" FontSize="12.5"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" Margin="2,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding DownloadsDisplay}" Foreground="{DynamicResource SubtleBrush}" FontSize="11.5"
                                   VerticalAlignment="Center" Margin="2,0" ToolTip="Загрузки"/>
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>

                <!-- Пусто -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasItems, ElementName=NugetList}" Value="False">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="34"
                             Foreground="#3A3A5C" HorizontalAlignment="Center"/>
                  <TextBlock Text="Введите запрос и нажмите «Найти»" Foreground="{DynamicResource MutedBrush}"
                             FontSize="13" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Кнопки скачивания -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="NugetProjBtn" Click="NugetProjectFile_Click" MinWidth="150" Margin="0,0,8,0"
                      ToolTip="Вставить .csproj / packages.config и скачать все пакеты с зависимостями">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A5;" FontSize="13"
                             Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock Text="Файл проекта" VerticalAlignment="Center" Margin="6,0,0,0"
                             Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
              </Button>
              <Button x:Name="NugetDownloadBtn" Style="{StaticResource AccentButton}"
                      Click="NugetDownload_Click" MinWidth="130">
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="13" Foreground="White"/>
                  <TextBlock Text="Скачать" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="White"/>
                </StackPanel>
              </Button>
              <Button x:Name="NugetCancelBtn" Content="✕ Отмена" Click="NugetCancel_Click"
                      MinWidth="90" Margin="8,0,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Прогресс -->
            <ProgressBar x:Name="NugetProgress" Grid.Row="9" IsIndeterminate="True" Visibility="Collapsed"/>

            <!-- Лог -->
            <Border Grid.Row="11" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
              <ScrollViewer x:Name="NugetLogScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NugetLog" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"
                           FontFamily="Cascadia Code, Consolas" FontSize="12" Margin="12,8"/>
              </ScrollViewer>
            </Border>
          </Grid>
        </Border>
      <!-- ══ NPM ═══════════════════════════════════════════════════════ -->
          <Border x:Name="SecNpm" Padding="24,10,24,16" Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="4"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="8"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <!-- Поиск (поле и кнопка объединены) -->
            <Border Grid.Row="0" Height="40" Background="{DynamicResource InputBrush}"
                    CornerRadius="9" BorderThickness="1">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="BorderBrush" Value="#43436A"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="13"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="13,0,0,0"/>
                <Grid Grid.Column="1" Margin="10,0,0,0">
                  <TextBox x:Name="NpmSearchBox" Style="{StaticResource FlatTextBox}" KeyDown="NpmSearchBox_KeyDown"/>
                  <TextBlock Text="Поиск NPM пакетов…" Foreground="{DynamicResource PlaceholderBrush}"
                             Margin="2,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=NpmSearchBox}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <Button x:Name="NpmSearchBtn" Grid.Column="2" Style="{StaticResource SearchButton}"
                        Click="NpmSearch_Click" Content="Найти" Margin="4" MinWidth="84"/>
              </Grid>
            </Border>

            <!-- Тулбар -->
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="NpmCountLabel" Grid.Column="0" VerticalAlignment="Center"
                         FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
              <TextBlock x:Name="NpmSelLabel" Grid.Column="1" VerticalAlignment="Center"
                         FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                         Visibility="Collapsed"/>
            </Grid>

            <!-- Заголовки колонок -->
            <Border Grid.Row="4" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0"
                    CornerRadius="10,10,0,0">
              <Grid Height="44" Margin="0,4,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="NpmSelectAllChk" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Margin="0" ToolTip="Выбрать все версии" Checked="NpmSelectAll_Changed" Unchecked="NpmSelectAll_Changed"/>
                <TextBlock Grid.Column="1" Text="Пакет · версии" VerticalAlignment="Center" Margin="10,0"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
              </Grid>
            </Border>

            <!-- Список результатов: пакеты сгруппированы по имени, внутри — версии -->
            <Border Grid.Row="5" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1"
                    CornerRadius="0,0,10,10" ClipToBounds="True">
              <Grid>
                <ListView x:Name="NpmList" ItemContainerStyle="{StaticResource ListViewItemStyleFluent}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListView.GroupStyle>
                    <GroupStyle>
                      <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="GroupItem">
                                <StackPanel>
                                  <ToggleButton x:Name="GroupToggle" IsChecked="False" Focusable="False" Cursor="Hand">
                                    <ToggleButton.Template>
                                      <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="hb" Background="{DynamicResource HeaderBg}" Padding="12,7"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                          <Grid>
                                            <Grid.ColumnDefinitions>
                                              <ColumnDefinition Width="Auto"/>
                                              <ColumnDefinition Width="Auto"/>
                                              <ColumnDefinition Width="Auto"/>
                                              <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" x:Name="chev" FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="10"
                                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2" Background="{DynamicResource BadgeGrayBg}" CornerRadius="9" Padding="7,1"
                                                    Margin="9,0,0,0" VerticalAlignment="Center">
                                              <TextBlock FontSize="11" Foreground="{DynamicResource BadgeGrayFg}">
                                                <Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=" верс."/>
                                              </TextBlock>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding Items[0].Description, Converter={StaticResource SingleLine}}"
                                                       Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                                                       Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                                       ToolTipService.InitialShowDelay="220" ToolTipService.ShowDuration="60000"
                                                       ToolTipService.Placement="Bottom" local:ToolTipBehavior.CloseOnLeave="True">
                                              <ToolTipService.ToolTip>
                                                <ContentControl Content="{Binding Items[0]}" ContentTemplate="{StaticResource PkgTipTemplate}"/>
                                              </ToolTipService.ToolTip>
                                            </TextBlock>
                                          </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                          <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="chev" Property="Text" Value="&#xE76C;"/>
                                          </Trigger>
                                          <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="hb" Property="Background" Value="{DynamicResource RowHover}"/>
                                          </Trigger>
                                        </ControlTemplate.Triggers>
                                      </ControlTemplate>
                                    </ToggleButton.Template>
                                  </ToggleButton>
                                  <ItemsPresenter x:Name="ip"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                  <Trigger SourceName="GroupToggle" Property="IsChecked" Value="False">
                                    <Setter TargetName="ip" Property="Visibility" Value="Collapsed"/>
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </GroupStyle.ContainerStyle>
                    </GroupStyle>
                  </ListView.GroupStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid Height="38">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="44"/>
                          <ColumnDefinition Width="36"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="NpmItemCheck_Click"/>
                        <TextBlock Grid.Column="1" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Version}" FontSize="12.5"
