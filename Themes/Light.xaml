<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="BgBrush"          Color="#EEF0F6"/>
  <SolidColorBrush x:Key="SurfaceBrush"     Color="#FFFFFF"/>
  <SolidColorBrush x:Key="CardBrush"        Color="#FFFFFF"/>
  <SolidColorBrush x:Key="InputBrush"       Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BorderBrush"      Color="#DCE0EB"/>
  <SolidColorBrush x:Key="TextBrush"        Color="#1B1B2E"/>
  <SolidColorBrush x:Key="MutedBrush"       Color="#6C6C82"/>
  <SolidColorBrush x:Key="SubtleBrush"      Color="#585870"/>
  <SolidColorBrush x:Key="RowHover"         Color="#EDEFF6"/>
  <SolidColorBrush x:Key="HeaderBg"         Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PlaceholderBrush" Color="#A6A6B8"/>
  <SolidColorBrush x:Key="ScrollThumb"      Color="#CCD0DC"/>
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#ABAFC0"/>
  <SolidColorBrush x:Key="IconBadgeBrush"   Color="#ECE7FB"/>

  <!-- Консоль сервера (светлый «терминал») -->
  <SolidColorBrush x:Key="ConsoleBg"        Color="#F4F5FA"/>
  <SolidColorBrush x:Key="ConsoleFg"        Color="#1F7A48"/>

  <!-- Цветные бейджи (тип пакета) -->
  <SolidColorBrush x:Key="BadgeBlueBg"   Color="#DCE6FB"/>
  <SolidColorBrush x:Key="BadgeBlueFg"   Color="#2A56C0"/>
  <SolidColorBrush x:Key="BadgeRedBg"    Color="#FBDDE7"/>
  <SolidColorBrush x:Key="BadgeRedFg"    Color="#BE2A56"/>
  <SolidColorBrush x:Key="BadgeGreenBg"  Color="#D6F1E4"/>
  <SolidColorBrush x:Key="BadgeGreenFg"  Color="#157A55"/>
  <SolidColorBrush x:Key="BadgeYellowBg" Color="#F6EBCD"/>
  <SolidColorBrush x:Key="BadgeYellowFg" Color="#946312"/>
  <SolidColorBrush x:Key="BadgePurpleBg" Color="#EAE1FB"/>
  <SolidColorBrush x:Key="BadgePurpleFg" Color="#6A3CC0"/>
  <SolidColorBrush x:Key="BadgeGrayBg"   Color="#E5E6F0"/>
  <SolidColorBrush x:Key="BadgeGrayFg"   Color="#585874"/>

  <SolidColorBrush x:Key="AppBgBrush" Color="#EEF0F6"/>

</ResourceDictionary>
