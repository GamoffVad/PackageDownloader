  <SolidColorBrush x:Key="BadgeYellowFg" Color="#E8C77C"/>
  <SolidColorBrush x:Key="BadgePurpleBg" Color="#3A2E5A"/>
  <SolidColorBrush x:Key="BadgePurpleFg" Color="#C6A8FF"/>
  <SolidColorBrush x:Key="BadgeGrayBg"   Color="#2E2E50"/>
  <SolidColorBrush x:Key="BadgeGrayFg"   Color="#B7B7D8"/>

