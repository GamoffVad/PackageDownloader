<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="BgBrush"          Color="#12121E"/>
  <SolidColorBrush x:Key="SurfaceBrush"     Color="#18182C"/>
  <SolidColorBrush x:Key="CardBrush"        Color="#1E1E38"/>
  <SolidColorBrush x:Key="InputBrush"       Color="#22223A"/>
  <SolidColorBrush x:Key="BorderBrush"      Color="#2E2E50"/>
  <SolidColorBrush x:Key="TextBrush"        Color="#E2E2F0"/>
