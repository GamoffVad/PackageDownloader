  <SolidColorBrush x:Key="SubtleBrush"      Color="#9090C0"/>
  <SolidColorBrush x:Key="RowHover"         Color="#20203C"/>
  <SolidColorBrush x:Key="HeaderBg"         Color="#14142A"/>
  <SolidColorBrush x:Key="PlaceholderBrush" Color="#5A5A80"/>
  <SolidColorBrush x:Key="ScrollThumb"      Color="#3A3A5C"/>
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#56567E"/>
  <SolidColorBrush x:Key="IconBadgeBrush"   Color="#262047"/>

